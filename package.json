{
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "cypress": "^15.11.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  },
  "scripts": {
    "test:all": "cypress run",
    "test:api": "cypress run --spec \"E2Ecypress/e2e/apiTests/**\"",
    "test:smoke": "cypress run --spec \"E2Ecypress/e2e/smokeTests/**\"",
    "test:ui": "cypress run --spec \"E2Ecypress/e2e/uiTests/**\"",
    "test:merge": "mochawesome-merge E2Ecypress/reports/*.json > E2Ecypress/reports/report_final.json",
    "test:report": "marge E2Ecypress/reports/report_final.json --reportDir E2Ecypress/reports --inline",
    "test:full": "npm run test:all && npm run test:merge && npm run test:report"
  }
}
