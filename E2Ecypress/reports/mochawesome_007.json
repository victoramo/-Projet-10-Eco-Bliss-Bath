              "context": null,
              "code": "// On boucle dans un seul it() pour éviter le problème de this dans forEach\nthis.xssPayloads.forEach(item => {\n  cy.request({\n    method: \"POST\",\n    url: `${apiUrl}/login`,\n    headers: {\n      \"Content-Type\": \"application/json\"\n    },\n    body: {\n      username: item.payload,\n      password: item.payload\n    },\n    failOnStatusCode: false\n  }).then(res => {\n    // ── Le payload XSS ne doit jamais authentifier ────────────────\n    expect(res.status, `${item.id} - statut doit être 401`).to.eq(401);\n    // ── La réponse ne doit pas refléter le payload brut ───────────\n    const body = JSON.stringify(res.body);\n    XSS_PATTERNS.forEach(pattern => {\n      expect(body, `${item.id} - réponse ne doit pas contenir \"${pattern}\"`).to.not.include(pattern);\n    });\n    cy.log(`✅ ${item.id} (${item.description}) bloqué — HTTP ${res.status}`);\n  });\n});",
